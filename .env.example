# --- Exchange (pilih sesuai config.yaml: exchange) ---
# Binance / Bybit: API key HARUS tanpa izin Withdraw. Aktifkan IP whitelist.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Hyperliquid: pakai API wallet (agent), BUKAN private key wallet utama.
HL_WALLET_ADDRESS=
HL_PRIVATE_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Telegram (opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pengaman live ---
# Live trading hanya jalan jika baris ini persis berisi kalimat di bawah
LIVE_CONFIRM=
# contoh: LIVE_CONFIRM=SAYA_PAHAM_RISIKONYA
